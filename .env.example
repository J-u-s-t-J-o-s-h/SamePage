# SamePage environment template
# Copy to `.env.local` for local development. Never commit real secrets.

# Public app URL used in local development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Node environment
NODE_ENV=development

# Disable Next.js anonymous CLI telemetry (privacy)
NEXT_TELEMETRY_DISABLED=1

# Reserved for Phase 1+ (PostgreSQL). Leave unset in Phase 0.
# DATABASE_URL=postgresql://samepage:samepage@127.0.0.1:5432/samepage

# Reserved for future local AI adapters. Cloud providers must stay disabled.
# SAMEPAGE_AI_PROVIDER=fake
# OLLAMA_BASE_URL=http://127.0.0.1:11434
