# =============================================================================
# SamePage environment configuration (EXAMPLE)
# -----------------------------------------------------------------------------
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# NEVER commit a real `.env` file. Only this `.env.example` is tracked.
# SamePage is local-first: it runs with ZERO configuration using the defaults
# below. Values here are only needed when you want to override a default.
# =============================================================================

# ---- Runtime --------------------------------------------------------------
# "development" | "production" | "test"
NODE_ENV=development

# Port the API server listens on. In production the API also serves the built
# web app (apps/web/dist) so this is the single port for the whole system.
PORT=8787

# Absolute or repo-relative path to the built web assets the API serves in
# production. Defaults to "apps/web/dist" relative to the process working dir.
# WEB_DIST=apps/web/dist

# Optional human-facing version label surfaced by the health endpoint.
# Defaults to the version in the root package.json.
# APP_VERSION=0.0.0

# =============================================================================
# The variables below are NOT used yet in Phase 0. They are documented here so
# the shape of future configuration is visible. They are activated in the
# phases noted in brackets. Leave them unset for now.
# =============================================================================

# ---- Database (Phase 1) ---------------------------------------------------
# PostgreSQL connection string for the local household database.
# DATABASE_URL=postgres://samepage:samepage@localhost:5432/samepage

# ---- Sessions / Auth (Phase 1) --------------------------------------------
# Long random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET=

# ---- Local file storage (Phase 3) -----------------------------------------
# Directory where original photos/audio/documents are stored (household-owned).
# UPLOAD_DIR=data/uploads
# Maximum accepted upload size in bytes (default 25 MiB).
# MAX_UPLOAD_BYTES=26214400

# ---- Local AI providers (Phase 3+) ----------------------------------------
# SamePage talks to LOCAL, self-hosted inference engines only. All AI is
# OPTIONAL and OFF by default; a deterministic built-in fake provider is used
# until a real local provider is explicitly configured. No third-party cloud
# AI is contacted by default.
#
# AI_PROVIDER=fake                     # fake | ollama | openai-compatible
# AI_TEXT_MODEL=                       # e.g. a small local instruct model
# OLLAMA_BASE_URL=http://localhost:11434
# OCR_ENGINE=tesseract                 # local OCR binary
# SPEECH_ENGINE=whisper                # local speech-to-text binary/server
